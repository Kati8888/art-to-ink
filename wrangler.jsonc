{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art-to-ink",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ARTWORK_FILES",
      "id": "de03271ad6ff4435959f9e7d2581984a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ART_TO_INK_DB",
      "database_id": "bb48b765-c807-433a-bb89-0ffbf9905285"
    }
  ]
}
